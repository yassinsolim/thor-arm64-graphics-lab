--- libs/vkd3d/resource.c	2026-09-22 08:36:00
+++ libs/vkd3d/resource.c	2026-10-01 16:58:42
@@ -2676,6 +2676,15 @@
 
     TRACE("iface %p, va #%"PRIx64"\n", iface, resource->res.va);
 
+    /* Addresses below the 64 KiB placement alignment are not a normal D3D12 buffer VA.
+     * Proton release builds strip TRACE, so this stays at WARN. */
+    if (resource->res.va < D3D12_DEFAULT_RESOURCE_PLACEMENT_ALIGNMENT)
+    {
+        WARN("GetGPUVirtualAddress low va %#"PRIx64", dim %u, width %"PRIu64", size %#"PRIx64", flags %#x.\n",
+                resource->res.va, resource->desc.Dimension, resource->desc.Width,
+                resource->res.size, resource->desc.Flags);
+    }
+
     return resource->res.va;
 }
 
