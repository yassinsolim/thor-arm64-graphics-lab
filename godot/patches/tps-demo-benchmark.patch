diff --git a/benchmark/benchmark_camera.gd b/benchmark/benchmark_camera.gd
new file mode 100644
index 0000000..0c8f6e3
--- /dev/null
+++ b/benchmark/benchmark_camera.gd
@@ -0,0 +1,169 @@
+class_name BenchmarkCamera
+extends Camera3D
+
+const BenchmarkConfig = preload("res://benchmark/benchmark_config.gd")
+
+var _elapsed: float = 0.0
+var _measuring: bool = false
+var _measure_elapsed: float = 0.0
+var _dts: Array[float] = []
+var _segment_lengths: PackedFloat32Array = PackedFloat32Array()
+var _path_length: float = 0.0
+
+
+static func attach(level: Node3D) -> void:
+	var cam := BenchmarkCamera.new()
+	cam.name = "BenchmarkCamera"
+	level.add_child(cam)
+
+
+func _ready() -> void:
+	current = true
+	_build_path()
+	BenchmarkConfig.apply_window()
+	RenderingServer.viewport_set_measure_render_time(get_viewport().get_viewport_rid(), true)
+	var size := BenchmarkConfig.render_size()
+	var window_size := DisplayServer.window_get_size()
+	print(
+		"BENCHMARK_READY renderer=%s driver=%s size=%dx%d window=%dx%d seed=%d warmup_sec=%.1f measure_sec=%.1f"
+		% [
+			RenderingServer.get_current_rendering_method(),
+			RenderingServer.get_current_rendering_driver_name(),
+			size.x,
+			size.y,
+			window_size.x,
+			window_size.y,
+			BenchmarkConfig.SEED,
+			BenchmarkConfig.WARMUP_SEC,
+			BenchmarkConfig.MEASURE_SEC,
+		]
+	)
+
+
+func _process(delta: float) -> void:
+	# lock before the measured window. doing it every measured frame
+	# resubmits vsync state and was idling the gpu.
+	if not _measuring:
+		BenchmarkConfig.lock_render()
+	_elapsed += delta
+	_place(_elapsed * BenchmarkConfig.SPEED_M_S)
+	if _elapsed >= BenchmarkConfig.TIMEOUT_SEC and not _measuring:
+		_fail("timeout_before_measure")
+		return
+	if not _measuring:
+		if _elapsed >= BenchmarkConfig.WARMUP_SEC:
+			_measuring = true
+			_measure_elapsed = 0.0
+			print("BENCHMARK_MEASURE_START")
+		return
+	if _elapsed >= BenchmarkConfig.TIMEOUT_SEC:
+		_fail("timeout_during_measure")
+		return
+	_measure_elapsed += delta
+	_dts.append(delta)
+	if _measure_elapsed >= BenchmarkConfig.MEASURE_SEC:
+		_finish()
+
+
+func _build_path() -> void:
+	var points := BenchmarkConfig.POINTS
+	_segment_lengths = PackedFloat32Array()
+	_path_length = 0.0
+	for i in points.size():
+		var a: Vector3 = points[i]
+		var b: Vector3 = points[(i + 1) % points.size()]
+		var length := a.distance_to(b)
+		_segment_lengths.append(length)
+		_path_length += length
+
+
+func _place(distance: float) -> void:
+	if _path_length <= 0.0:
+		return
+	var along := fposmod(distance, _path_length)
+	var points := BenchmarkConfig.POINTS
+	for i in points.size():
+		var length := _segment_lengths[i]
+		if along > length and i < points.size() - 1:
+			along -= length
+			continue
+		var a: Vector3 = points[i]
+		var b: Vector3 = points[(i + 1) % points.size()]
+		var t := 0.0 if length <= 0.0 else along / length
+		global_position = a.lerp(b, t)
+		var ahead := b - a
+		if ahead.length_squared() < 0.0001:
+			ahead = Vector3(0, 0, -1)
+		look_at(global_position + ahead, Vector3.UP)
+		return
+
+
+func _print_frame_stats() -> void:
+	var rid: RID = get_viewport().get_viewport_rid()
+	var visible_draws: int = RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_VISIBLE, RenderingServer.VIEWPORT_RENDER_INFO_DRAW_CALLS_IN_FRAME)
+	var visible_prims: int = RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_VISIBLE, RenderingServer.VIEWPORT_RENDER_INFO_PRIMITIVES_IN_FRAME)
+	var visible_objs: int = RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_VISIBLE, RenderingServer.VIEWPORT_RENDER_INFO_OBJECTS_IN_FRAME)
+	var shadow_draws: int = RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_SHADOW, RenderingServer.VIEWPORT_RENDER_INFO_DRAW_CALLS_IN_FRAME)
+	var shadow_prims: int = RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_SHADOW, RenderingServer.VIEWPORT_RENDER_INFO_PRIMITIVES_IN_FRAME)
+	var shadow_objs: int = RenderingServer.viewport_get_render_info(rid, RenderingServer.VIEWPORT_RENDER_INFO_TYPE_SHADOW, RenderingServer.VIEWPORT_RENDER_INFO_OBJECTS_IN_FRAME)
+	var gpu_ms: float = RenderingServer.viewport_get_measured_render_time_gpu(rid)
+	var cpu_ms: float = RenderingServer.viewport_get_measured_render_time_cpu(rid)
+	print(
+		"FRAME_STATS visible_draws=%d visible_prims=%d visible_objs=%d shadow_draws=%d shadow_prims=%d shadow_objs=%d gpu_ms=%.3f cpu_ms=%.3f"
+		% [visible_draws, visible_prims, visible_objs, shadow_draws, shadow_prims, shadow_objs, gpu_ms, cpu_ms]
+	)
+
+
+func _finish() -> void:
+	_print_frame_stats()
+	var render_size := BenchmarkConfig.render_size()
+	var window_size := DisplayServer.window_get_size()
+	var scale := float(Settings.config_file.get_value("video", "resolution_scale"))
+	var summary: Dictionary = {
+		"frames": _dts.size(),
+		"p50_ms": _percentile(0.50) * 1000.0,
+		"p95_ms": _percentile(0.95) * 1000.0,
+		"min_ms": _min_dt() * 1000.0,
+		"max_ms": _max_dt() * 1000.0,
+		"renderer": RenderingServer.get_current_rendering_method(),
+		"driver": RenderingServer.get_current_rendering_driver_name(),
+		"seed": BenchmarkConfig.SEED,
+		"width": render_size.x,
+		"height": render_size.y,
+		"window_width": window_size.x,
+		"window_height": window_size.y,
+		"scale": scale,
+		"gi": int(Settings.config_file.get_value("rendering", "gi_type")),
+		"render_width": int(round(float(render_size.x) * scale)),
+		"render_height": int(round(float(render_size.y) * scale)),
+	}
+	print("BENCHMARK_DONE " + JSON.stringify(summary))
+	get_tree().quit(0)
+
+
+func _fail(reason: String) -> void:
+	print("BENCHMARK_FAIL " + reason)
+	get_tree().quit(2)
+
+
+func _percentile(q: float) -> float:
+	if _dts.is_empty():
+		return 0.0
+	var ordered := _dts.duplicate()
+	ordered.sort()
+	var idx := clampi(int(floor(q * float(ordered.size() - 1))), 0, ordered.size() - 1)
+	return ordered[idx]
+
+
+func _min_dt() -> float:
+	var value := _dts[0]
+	for dt in _dts:
+		value = minf(value, dt)
+	return value
+
+
+func _max_dt() -> float:
+	var value := _dts[0]
+	for dt in _dts:
+		value = maxf(value, dt)
+	return value
