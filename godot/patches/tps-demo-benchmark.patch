+func _apply_flat_materials(root: Node) -> int:
+	# same meshes and coverage, no textures and no lighting.
+	var mat := StandardMaterial3D.new()
+	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+	mat.albedo_color = Color(0.72, 0.72, 0.72)
+	return _override_meshes(root, mat)
+
+
+func _override_meshes(node: Node, mat: Material) -> int:
+	var count := 0
+	if node is MeshInstance3D:
+		(node as MeshInstance3D).material_override = mat
+		count += 1
+	for child in node.get_children():
+		count += _override_meshes(child, mat)
+	return count
+
+
+func _hide_blended_meshes(node: Node) -> Array[int]:
+	var hidden := 0
+	var mixed := 0
+	if node is MeshInstance3D:
+		var mesh_inst: MeshInstance3D = node as MeshInstance3D
+		var kind := _blend_kind(mesh_inst)
+		if kind == 2:
+			mesh_inst.visible = false
+			hidden += 1
+		elif kind == 1:
+			mixed += 1
+	for child in node.get_children():
+		var nested: Array[int] = _hide_blended_meshes(child)
+		hidden += nested[0]
+		mixed += nested[1]
+	var out: Array[int] = [hidden, mixed]
+	return out
+
+
+func _blend_kind(mesh_inst: MeshInstance3D) -> int:
+	# 0 none, 1 mixed, 2 every surface is alpha blended.
+	var mesh: Mesh = mesh_inst.mesh
+	if mesh == null:
+		return 0
+	var surfaces := mesh.get_surface_count()
+	if surfaces == 0:
+		return 0
+	var blended := 0
+	for i in surfaces:
+		var mat: Material = mesh_inst.get_surface_override_material(i)
+		if mat == null:
+			mat = mesh.surface_get_material(i)
+		if _material_is_blended(mat):
+			blended += 1
+	if blended == 0:
+		return 0
+	if blended == surfaces:
+		return 2
+	return 1
+
+
+func _material_is_blended(mat: Material) -> bool:
+	if mat == null:
+		return false
+	if mat is BaseMaterial3D:
+		var mode: int = (mat as BaseMaterial3D).transparency
+		return mode == BaseMaterial3D.TRANSPARENCY_ALPHA or mode == BaseMaterial3D.TRANSPARENCY_ALPHA_DEPTH_PRE_PASS
+	if mat is ShaderMaterial:
+		var path := mat.resource_path
+		return path.ends_with("light_shafts.tres") or path.ends_with("tile_glass.tres") or path.ends_with("scifi_car_glass.tres")
+	return false
+
