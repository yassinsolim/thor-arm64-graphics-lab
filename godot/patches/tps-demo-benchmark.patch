diff --git a/benchmark/benchmark_config.gd b/benchmark/benchmark_config.gd
new file mode 100644
index 0000000..7c40881
--- /dev/null
+++ b/benchmark/benchmark_config.gd
@@ -0,0 +1,112 @@
+extends Object
+
+# measurement controls only. graphics quality stays on the demo defaults.
+const SEED: int = 20261002
+const WIDTH: int = 1280
+const HEIGHT: int = 720
+const WARMUP_SEC: float = 8.0
+const MEASURE_SEC: float = 20.0
+const TIMEOUT_SEC: float = 180.0
+const SPEED_M_S: float = 4.0
+
+# eye-height points along the existing player-spawn walkway.
+const POINTS: Array[Vector3] = [
+	Vector3(64.82, 0.55, 78.76),
+	Vector3(55.65, 0.55, 80.59),
+	Vector3(47.07, 0.55, 85.30),
+	Vector3(38.76, 0.55, 91.51),
+	Vector3(28.13, 0.55, 93.71),
+]
+
+
+static func enabled() -> bool:
+	return "--benchmark" in OS.get_cmdline_user_args()
+
+
+static func user_value(flag: String) -> String:
+	var args := OS.get_cmdline_user_args()
+	var index := args.find(flag)
+	if index >= 0 and index + 1 < args.size():
+		return str(args[index + 1])
+	return ""
+
+
+static func native_window() -> bool:
+	return "--bench-native" in OS.get_cmdline_user_args()
+
+
+static func apply_window() -> void:
+	var window: Window = Engine.get_main_loop().root as Window
+	window.mode = Window.MODE_WINDOWED
+	if native_window():
+		# let gamescope own the window size. 3d follows that window.
+		window.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
+	else:
+		# gamescope resizes the x window to the panel. viewport scale keeps the
+		# 3d render at 1280x720 instead of following that resize.
+		window.content_scale_mode = Window.CONTENT_SCALE_MODE_VIEWPORT
+		window.content_scale_aspect = Window.CONTENT_SCALE_ASPECT_IGNORE
+		window.content_scale_size = Vector2i(WIDTH, HEIGHT)
+		DisplayServer.window_set_size(Vector2i(WIDTH, HEIGHT))
+	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
+	Engine.max_fps = 0
+	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
+
+
+static func lock_render() -> void:
+	var window: Window = Engine.get_main_loop().root as Window
+	if native_window():
+		if window.content_scale_mode != Window.CONTENT_SCALE_MODE_DISABLED:
+			window.content_scale_mode = Window.CONTENT_SCALE_MODE_DISABLED
+	else:
+		var wanted := Vector2i(WIDTH, HEIGHT)
+		if window.content_scale_mode != Window.CONTENT_SCALE_MODE_VIEWPORT or window.content_scale_size != wanted:
+			window.content_scale_mode = Window.CONTENT_SCALE_MODE_VIEWPORT
+			window.content_scale_aspect = Window.CONTENT_SCALE_ASPECT_IGNORE
+			window.content_scale_size = wanted
+	DisplayServer.window_set_vsync_mode(DisplayServer.VSYNC_DISABLED)
+	Engine.max_fps = 0
+	apply_shade()
+
+
+static func apply_shade() -> void:
+	# unshaded keeps the fragments and drops light/material work.
+	# wireframe is polygon-line mode, not a smaller fill.
+	# flat is applied on the meshes in the level, not here.
+	var shade := user_value("--bench-shade")
+	if shade == "":
+		return
+	var vp: Viewport = Engine.get_main_loop().root.get_viewport()
+	if shade == "unshaded":
+		vp.debug_draw = Viewport.DEBUG_DRAW_UNSHADED
+	elif shade == "wireframe":
+		vp.debug_draw = Viewport.DEBUG_DRAW_WIREFRAME
+
+
+static func render_size() -> Vector2i:
+	var window: Window = Engine.get_main_loop().root as Window
+	if native_window():
+		return DisplayServer.window_get_size()
+	return window.content_scale_size
+
+
+static func prepare_settings() -> void:
+	# pin the demo's own defaults in memory. an old user://settings.ini
+	# must not change quality. do not write that file back.
+	for section in Settings.DEFAULTS:
+		for key in Settings.DEFAULTS[section]:
+			Settings.config_file.set_value(section, key, Settings.DEFAULTS[section][key])
+	Settings.config_file.set_value("video", "display_mode", Window.MODE_WINDOWED)
+	Settings.config_file.set_value("video", "vsync", DisplayServer.VSYNC_DISABLED)
+	Settings.config_file.set_value("video", "max_fps", 0)
+	var scale_text := user_value("--bench-scale")
+	if scale_text != "":
+		Settings.config_file.set_value("video", "resolution_scale", float(scale_text))
+	var gi := user_value("--bench-gi")
+	if gi == "lightmap":
+		Settings.config_file.set_value("rendering", "gi_type", Settings.GIType.LIGHTMAP_GI)
+	elif gi == "sdfgi":
+		Settings.config_file.set_value("rendering", "gi_type", Settings.GIType.SDFGI)
+	if user_value("--bench-shadows") == "off":
+		Settings.config_file.set_value("rendering", "shadow_mapping", false)
+	apply_window()
